# Copy this file to .env for local testing
# NEVER commit .env to GitHub

# 1. RapidAPI key — sign up at https://rapidapi.com, subscribe to JSearch
RAPIDAPI_KEY=your_rapidapi_key_here

# 2. Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# 3. Telegram bot token — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABC...

# 4. Your Telegram chat ID — see README for how to find this
TELEGRAM_CHAT_ID=your_chat_id_here
